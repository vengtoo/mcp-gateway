{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.vengtoo/mcp-gateway",
  "description": "Vengtoo MCP Gateway — policy-enforcing proxy between AI agents and MCP servers",
  "repository": {
    "url": "https://github.com/vengtoo/mcp-gateway",
    "source": "github"
  },
  "version": "0.1.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@vengtoo/mcp-gateway",
      "version": "0.1.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "description": "Your Vengtoo API key",
          "isRequired": true,
          "format": "string",
          "isSecret": true,
          "name": "VENGTOO_API_KEY"
        }
      ]
    }
  ]
}
